<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to PawMatch 🐾"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#6D4C41" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose a category and meet your new friend."
            android:textSize="15sp"
            android:textColor="#8D6E63"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnCats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cats"
            android:backgroundTint="#FFAB91"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnDogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dogs"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FF8A65"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnAllPets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All Pets"
            android:layout_marginTop="12dp"
            android:backgroundTint="#A1887F"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Favorites"
            android:layout_marginTop="12dp"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnShelters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nearby Shelters"
            android:layout_marginTop="12dp"
            android:backgroundTint="#6D4C41"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
